DATABASE_URL=mysql+pymysql://user:password@localhost:3306/unnine
# Railway에서는 MYSQL_URL=${{MySQL.MYSQL_URL}} 도 동일하게 인식합니다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_API_KEY=replace-with-long-random-secret
ORDERS_ENABLED=false

# Cloudflare R2 (bucket: sister). Public access URL required for browser image loads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sisterfood
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# aliases also accepted: R2_BUCKET_NAME, R2_PUBLIC_BASE_URL
